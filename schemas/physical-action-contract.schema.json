{"$defs":{"Evidence":{"description":"Provenance: which observation led to this contract.","properties":{"observation_id":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Observation Id"},"summary":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Summary"}},"title":"Evidence","type":"object"},"Risk":{"enum":["read_only","low","medium","high","critical"],"title":"Risk","type":"string"},"Target":{"additionalProperties":true,"properties":{"type":{"description":"Kind of physical target, e.g. 'environment', 'machine', 'zone'.","title":"Type","type":"string"},"location":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"Human-readable location, e.g. 'kitchen'.","title":"Location"},"resource":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"Stable asset identifier if known.","title":"Resource"}},"required":["type"],"title":"Target","type":"object"},"Verification":{"properties":{"condition":{"description":"Declarative success condition, e.g. 'temperature_c <= 24'.","title":"Condition","type":"string"},"timeout_seconds":{"default":300,"minimum":1,"title":"Timeout Seconds","type":"integer"},"retry_limit":{"default":0,"minimum":0,"title":"Retry Limit","type":"integer"}},"required":["condition"],"title":"Verification","type":"object"}},"$id":"https://github.com/mashkovd/newton-mcp-gateway/schemas/physical-action-contract.schema.json","description":"Tool-independent description of a desired physical-world outcome.","properties":{"version":{"default":"0.1","pattern":"^0\\.1$","title":"Version","type":"string"},"goal":{"description":"Desired outcome, independent of any specific tool.","title":"Goal","type":"string"},"reason":{"description":"Why the action is proposed.","title":"Reason","type":"string"},"confidence":{"anyOf":[{"maximum":1.0,"minimum":0.0,"type":"number"},{"type":"null"}],"default":null,"title":"Confidence"},"target":{"$ref":"#/$defs/Target"},"constraints":{"additionalProperties