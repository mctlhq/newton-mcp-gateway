# Backend selection: "mock" (no credentials needed) or "api" (real Archetype Newton).
NEWTON_BACKEND=mock

# Only required when NEWTON_BACKEND=api. Variable names follow Archetype's
# official docs (docs.archetypeai.app/libraries/environment-variables).
# The endpoint MUST include the API version path.
ATAI_API_KEY=
ATAI_API_ENDPOINT=https://api.u1.archetypeai.app/v0.5

# Model identifiers exposed on /query. The exact identifiers available to your
# organization may differ — check the Model Registry in the Developer Console.
NEWTON_TEXT_MODEL=Newton::c2_5_8b_260413b723a9ab
NEWTON_OMEGA_MODEL=OmegaEncoder::omega_embeddings_01

# Maximum decoded byte size newton_analyze_image accepts for an inline image_base64
# payload (default 8 MiB). Transport-shaped (the base64 arrives inside a JSON MCP
# tool argument), not a documented Archetype limit. Must be > 0 and <= 512 MiB (the
# documented Files API upload ceiling).
NEWTON_MAX_IMAGE_BYTES=8388608

# MCP transport: "stdio" (default, for Claude Desktop / Claude Code) or
# "streamable-http" (for reaching the gateway over HTTP, e.g. from a container).
# The Docker image overrides this to "streamable-http" at the image level.
NEWTON_MCP_TRANSPORT=stdio

# NEWTON_MCP_HOST/NEWTON_MCP_PORT are only used when NEWTON_MCP_TRANSPORT=streamable-http.
# These are the preferred, namespaced names; the bare HOST/PORT are still accepted as a
# lower-precedence fallback for existing setups. Prefer the prefixed names: HOST in
# particular collides with a shell-reserved parameter (e.g. zsh's $HOST), which can
# silently change which interface the server binds to. The Docker image ships the bare
# HOST=0.0.0.0/PORT=8000 as compatibility defaults; override with
# -e NEWTON_MCP_HOST=.../-e NEWTON_MCP_PORT=... to take precedence.
NEWTON_MCP_HOST=127.0.0.1
NEWTON_MCP_PORT=8000

# Path to a runtime.yaml allow-list for the action runtime (src/newton_mcp/runtime/,
# Direction A proposal: MCP host, tool discovery and deterministic capability resolver).
# Only read by newton_mcp.runtime.load_runtime_config(); unused by the MCP server above.
# See examples/runtime.example.yaml and docs/action-runtime.md.
# NEWTON_MCP_RUNTIME_CONFIG=/path/to/runtime.yaml

# Path to a policy.yaml file for the action runtime's policy engine
# (src/newton_mcp/action/policy.py). Only read by newton_mcp.action.load_policy();
# unused by the MCP server above. See examples/policy.example.yaml and
# docs/action-runtime.md.
# NEWTON_MCP_POLICY_PATH=/path/to/policy.yaml

# Path to a JSONL audit log file for the action runtime's lifecycle transitions
# (src/newton_mcp/runtime/audit.py). Only read by newton_mcp.runtime.load_audit_sink();
# unused by the MCP server above. Unlike NEWTON_MCP_RUNTIME_CONFIG/NEWTON_MCP_POLICY_PATH,
# leaving this unset (or blank) means auditing is disabled (an in-memory sink) rather than
# failing loudly -- an audit sink is not an authority boundary. A path that IS set but
# unusable (missing parent directory, a directory, not writable) still raises loudly.
# See docs/action-runtime.md.
# NEWTON_MCP_AUDIT_PATH=/path/to/action-audit.jsonl
